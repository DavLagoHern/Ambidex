{
  "name": "ambidex",
  "productName": "Ambidex",
  "version": "0.2.0",
  "description": "Claude Code and Codex, working as one: a macOS desktop app that runs the official CLIs with your own plans.",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --bundles app",
    "start": "open src-tauri/target/release/bundle/macos/Ambidex.app",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest",
    "check": "npm run typecheck && npm test && npm run test:native && npm run build",
    "test:e2e": "node tests/e2e/tauri.mjs",
    "dist": "npm run build && node scripts/sign.mjs",
    "dist:dmg": "tauri build --bundles app,dmg",
    "install:app": "node scripts/install-app.mjs",
    "icon": "sips -s format png build/icon.icns --out build/icon.png",
    "build:assets": "node scripts/build-engine.mjs && vite build",
    "dev:assets": "node scripts/dev-assets.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "4.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "5.5.0",
    "lucide-react": "^1.66.0",
    "monaco-editor": "0.52.2",
    "playwright-core": "^1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "^3.2.7",
    "@tauri-apps/cli": "^2.10.0",
    "esbuild": "^0.25.0"
  },
  "author": {
    "name": "DavLagoHern"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavLagoHern/Ambidex.git"
  },
  "homepage": "https://github.com/DavLagoHern/Ambidex"
}
