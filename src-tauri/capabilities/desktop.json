{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Only the local workspace UI may call native commands; guest web pages receive no permissions.",
  "local": true,
  "webviews": [
    "main",
    "panel-*",
    "web-window-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
